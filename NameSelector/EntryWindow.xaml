<Window x:Class="NameSelector.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NameSelector.Converters"
        Title="功能入口 - by Poloza"
        Height="460" Width="760"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        Background="#F5F6F7">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="请选择一个功能"
                   converters:Scale.FontSize="36,30"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button Content="点名分组工具"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="28,24"
                    Background="#2980B9"
                    MinWidth="230"
                    MinHeight="96"
                    Padding="28,12"
                    Margin="0,0,32,0"
                    Click="RollCall_Click" />
            <Button Content="周次情况记录表"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="28,24"
                    Background="#16A085"
                    MinWidth="230"
                    MinHeight="96"
                    Padding="28,12"
                    Click="Weekly_Click" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="Demo 试水版：点名功能与周次情况记录表暂由本入口分流。"
                   converters:Scale.FontSize="20,18"
                   Foreground="#7F8C8D"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
