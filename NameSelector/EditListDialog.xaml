<Window x:Class="NameSelector.EditListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NameSelector.Converters"
        Title="修改名单"
        Height="520" Width="560"
        MinHeight="380" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei"
        Background="#F5F6F7">
    <Grid Margin="16">
        <!-- 提示、编辑区、按钮区按 1 : 7 : 1.4 自适应 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="7*" />
            <RowDefinition Height="1.4*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="每行一个名字。保存后名单将重新编号，所有点名状态会被重置。"
                   converters:Scale.FontSize="18,18"
                   Foreground="#7F8C8D"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,0,0,8" />

        <TextBox Grid.Row="1"
                 x:Name="NamesBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 converters:Scale.FontSize="20,18"
                 Padding="10,8"
                 BorderBrush="#BDC3C7"
                 Background="White"
                 Foreground="#2C3E50" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,8,0,0">
            <Button Content="保存"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,18"
                    Background="#27AE60"
                    MinWidth="110"
                    Margin="0,0,12,0"
                    Click="Save_Click" />
            <Button Content="取消"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,18"
                    Background="#7F8C8D"
                    MinWidth="110"
                    Margin="0"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
