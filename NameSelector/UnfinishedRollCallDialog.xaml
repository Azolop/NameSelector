<Window x:Class="NameSelector.UnfinishedRollCallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NameSelector.Converters"
        Title="开始新一轮点名"
        Width="520" Height="260"
        MinWidth="440" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        Background="#F5F6F7">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="上次点名没有结束。&#10;需要重新开始新一轮点名吗？"
                   converters:Scale.FontSize="22,22"
                   Foreground="#2C3E50"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
            <Button Content="开启新的点名"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,20"
                    Background="#27AE60"
                    MinWidth="140"
                    Margin="0,0,16,0"
                    Click="StartNew_Click" />
            <Button Content="维持当前状态"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,20"
                    Background="#7F8C8D"
                    MinWidth="140"
                    Click="KeepCurrent_Click" />
        </StackPanel>
    </Grid>
</Window>
