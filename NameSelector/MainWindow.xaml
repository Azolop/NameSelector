<Window x:Class="NameSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NameSelector.Models"
        xmlns:converters="clr-namespace:NameSelector.Converters"
        mc:Ignorable="d"
        Title="点名分组工具"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        Background="#F5F6F7"
        Closing="Window_Closing">
    <Window.Resources>
        <converters:OrderStatusConverter x:Key="OrderStatusConverter" />

        <!-- 学生卡片数据模板：卡片高度与字号随窗口等比缩放 -->
        <DataTemplate x:Key="StudentCardTemplate" DataType="{x:Type models:Student}">
            <Button Click="StudentCard_Click"
                    Cursor="Hand"
                    converters:Scale.Height="88,64"
                    Margin="4"
                    Padding="10,6"
                    ToolTip="点击切换点名状态">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#BDC3C7"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CardBorder" Property="Opacity" Value="0.65" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                <Setter Property="Background" Value="#1A5276" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               converters:Scale.FontSize="22,20"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#2C3E50" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="DemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock converters:Scale.FontSize="18,18"
                               Margin="0,4,0,0"
                               TextAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource OrderStatusConverter}">
                                <Binding Path="IsCalled" />
                                <Binding Path="Order" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#7F8C8D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="DemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <!-- 顶部区域、按钮行、名单阵列按 1.6 : 1.2 : 7.2 的比例自适应 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1.6*" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="7.2*" />
        </Grid.RowDefinitions>

        <!-- 顶部统计信息栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D5DBDB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,8,0"
                    Padding="14,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TotalCountText"
                               converters:Scale.FontSize="34,18"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               Text="0"
                               TextAlignment="Center" />
                    <TextBlock converters:Scale.FontSize="18,18"
                               Foreground="#7F8C8D"
                               Text="总人数"
                               TextAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#D5DBDB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="8,0"
                    Padding="14,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CalledCountText"
                               converters:Scale.FontSize="34,18"
                               FontWeight="Bold"
                               Foreground="#1A5276"
                               Text="0"
                               TextAlignment="Center" />
                    <TextBlock converters:Scale.FontSize="18,18"
                               Foreground="#7F8C8D"
                               Text="已点人数"
                               TextAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D5DBDB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="8,0,0,0"
                    Padding="14,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UncalledCountText"
                               converters:Scale.FontSize="34,18"
                               FontWeight="Bold"
                               Foreground="#E67E22"
                               Text="0"
                               TextAlignment="Center" />
                    <TextBlock converters:Scale.FontSize="18,18"
                               Foreground="#7F8C8D"
                               Text="未点人数"
                               TextAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 功能按钮行：5 等分，随窗口等比伸缩 -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,10,0,10">
            <Button Margin="5"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,18"
                    Background="#27AE60"
                    Click="EditList_Click">
                <TextBlock Text="📝 修改名单" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button Margin="5"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,18"
                    Background="#7F8C8D"
                    Click="EndRollCall_Click">
                <TextBlock Text="🔚 结束本次点名" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button Margin="5"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,18"
                    Background="#E74C3C"
                    Click="RandomAll_Click">
                <TextBlock Text="🎲 随机选人（全部）" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button Margin="5"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,18"
                    Background="#1A5276"
                    Click="RandomUncalled_Click">
                <TextBlock Text="🎲 随机选人（未点）" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button Margin="5"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="20,18"
                    Background="#2980B9"
                    Click="RandomCalled_Click">
                <TextBlock Text="🎲 随机选人（已点）" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </UniformGrid>

        <!-- 名单阵列：固定 8 列，行数自动 -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StudentGrid" ItemTemplate="{StaticResource StudentCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint"
                       Text="名单为空，请先点击「修改名单」添加学生"
                       converters:Scale.FontSize="24,18"
                       Foreground="#7F8C8D"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
