<Window x:Class="NameSelector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:NameSelector.Models"
        xmlns:converters="clr-namespace:NameSelector.Converters"
        mc:Ignorable="d"
        Title="点名分组工具 - by Poloza"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        Background="#F5F6F7"
        Closing="Window_Closing">
    <Window.Resources>
        <converters:StatusTextConverter x:Key="StatusTextConverter" />
        <converters:OrderOnlyConverter x:Key="OrderOnlyConverter" />

        <!-- 统计卡片通用样式 -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D5DBDB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <!-- 学生卡片数据模板：卡片高度与字号随窗口等比缩放 -->
        <DataTemplate x:Key="StudentCardTemplate" DataType="{x:Type models:Student}">
            <Button Click="StudentCard_Click"
                    Cursor="Hand"
                    converters:Scale.Height="78,60"
                    Margin="4"
                    Padding="8,4"
                    ToolTip="点击切换点名状态">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CardBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#BDC3C7"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CardBorder" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CardBorder" Property="Opacity" Value="0.65" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                <Setter Property="Background" Value="#1A5276" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               converters:Scale.FontSize="20,20"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#2C3E50" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="DemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock converters:Scale.FontSize="18,18"
                               Margin="0,2,0,0"
                               TextAlignment="Center"
                               Text="{Binding IsCalled, Converter={StaticResource StatusTextConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#7F8C8D" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="DemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock converters:Scale.FontSize="18,18"
                               Margin="0,2,0,0"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource OrderOnlyConverter}">
                                <Binding Path="IsCalled" />
                                <Binding Path="Order" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <!-- 左侧信息栏 : 右侧名单阵列 = 2 : 8 -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="8*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧信息栏：统计 + 功能按钮，从上到下 8 行等分 -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource StatCard}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="总人数："
                               converters:Scale.FontSize="22,18"
                               Foreground="#7F8C8D"
                               TextAlignment="Left" />
                    <TextBlock Grid.Column="1"
                               x:Name="TotalCountText"
                               converters:Scale.FontSize="30,18"
                               FontWeight="Bold"
                               Foreground="#2C3E50"
                               Text="0"
                               TextAlignment="Right" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource StatCard}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="未点数："
                               converters:Scale.FontSize="22,18"
                               Foreground="#7F8C8D"
                               TextAlignment="Left" />
                    <TextBlock Grid.Column="1"
                               x:Name="UncalledCountText"
                               converters:Scale.FontSize="30,18"
                               FontWeight="Bold"
                               Foreground="#E67E22"
                               Text="0"
                               TextAlignment="Right" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource StatCard}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="已点数："
                               converters:Scale.FontSize="22,18"
                               Foreground="#7F8C8D"
                               TextAlignment="Left" />
                    <TextBlock Grid.Column="1"
                               x:Name="CalledCountText"
                               converters:Scale.FontSize="30,18"
                               FontWeight="Bold"
                               Foreground="#1A5276"
                               Text="0"
                               TextAlignment="Right" />
                </Grid>
            </Border>

            <Button Grid.Row="3"
                    Margin="0,4"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="18,18"
                    Background="#E74C3C"
                    Click="RandomAll_Click">
                <TextBlock Text="随机选人（全部）" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>

            <Button Grid.Row="4"
                    Margin="0,4"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="18,18"
                    Background="#2980B9"
                    Click="RandomCalled_Click">
                <TextBlock Text="随机选人（已点）" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>

            <Button Grid.Row="5"
                    Margin="0,4"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="18,18"
                    Background="#1A5276"
                    Click="RandomUncalled_Click">
                <TextBlock Text="随机选人（未点）" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>

            <Button Grid.Row="6"
                    Margin="0,4"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="18,18"
                    Background="#7F8C8D"
                    Click="EndRollCall_Click">
                <TextBlock Text="结束本次点名" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>

            <Button Grid.Row="7"
                    Margin="0,4"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="18,18"
                    Background="#27AE60"
                    Click="EditList_Click">
                <TextBlock Text="修改名单" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </Grid>

        <!-- 右侧名单阵列：固定 8 列，行数自动 -->
        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StudentGrid" ItemTemplate="{StaticResource StudentCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint"
                       Text="名单为空，请先点击「修改名单」添加学生"
                       converters:Scale.FontSize="24,18"
                       Foreground="#7F8C8D"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
