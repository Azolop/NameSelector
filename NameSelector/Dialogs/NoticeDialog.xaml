<Window x:Class="NameSelector.Dialogs.NoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NameSelector.Converters"
        Title="提示"
        Width="800" Height="420"
        MinWidth="640" MinHeight="340"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei"
        Background="#F5F6F7"
        ShowInTaskbar="False">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   converters:Scale.FontSize="38,32"
                   FontWeight="Bold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="MessageText"
                       converters:Scale.FontSize="30,26"
                       Foreground="#2C3E50"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
        </ScrollViewer>

        <StackPanel x:Name="ButtonPanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button x:Name="PrimaryButton"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="28,24"
                    MinWidth="220"
                    MinHeight="68"
                    Padding="28,10"
                    Margin="0,0,20,0"
                    Click="PrimaryButton_Click" />
            <Button x:Name="SecondaryButton"
                    Style="{StaticResource AppButton}"
                    converters:Scale.FontSize="28,24"
                    MinWidth="220"
                    MinHeight="68"
                    Padding="28,10"
                    Margin="0"
                    Visibility="Collapsed"
                    Click="SecondaryButton_Click" />
        </StackPanel>
    </Grid>
</Window>
