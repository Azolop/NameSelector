<Window x:Class="NameSelector.WeekRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NameSelector.Converters"
        Title="周次情况记录表 - by Poloza"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        Background="#F5F6F7"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏：生成 + 下拉选择 + 保存 -->
        <Border Background="White"
                BorderBrush="#D5DBDB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="GenerateButton"
                        Content="生成周次表"
                        Style="{StaticResource AppButton}"
                        converters:Scale.FontSize="20,18"
                        Background="#2980B9"
                        Click="Generate_Click" />
                <ComboBox x:Name="WeekCombo"
                          Grid.Column="1"
                          Margin="14,0"
                          VerticalAlignment="Center"
                          converters:Scale.FontSize="20,18"
                          SelectionChanged="WeekCombo_SelectionChanged" />
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Content="保存"
                        Style="{StaticResource AppButton}"
                        converters:Scale.FontSize="20,18"
                        Background="#27AE60"
                        IsEnabled="False"
                        Click="Save_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   converters:Scale.FontSize="18,16"
                   Foreground="#7F8C8D"
                   Margin="4,8,4,4"
                   TextWrapping="Wrap" />

        <!-- 表格区 -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D5DBDB"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
            <Grid>
                <ScrollViewer x:Name="TableScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="TableHost" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint"
                           Text="还没有周次表。点击「生成周次表」按当前名单创建一张。"
                           converters:Scale.FontSize="24,18"
                           Foreground="#7F8C8D"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
